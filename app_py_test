import pytest
from app import app

@pytest.fixture
def client():
    with app.test_client() as client:
        yield client

def test_movie_search_by_genre_and_language(client):
    # Test for correct genre and language that exist in the database
    response = client.get('/movies/search?genre=Action&language=en')
    assert response.status_code == 200
    movies = response.get_json()
    # Check that the response is not empty and the returned movie matches the criteria
    assert len(movies) == 1
    assert 'Action' in movies[0]['genres'] and movies[0]['original_language'] == 'en'

def test_movie_search_by_nonexistent_genre_and_language(client):
    # Test for genre and language combination that does not exist
    response = client.get('/movies/search?genre=FakeGenre&language=xx')
    assert response.status_code == 404
    assert response.get_json() == {'message': 'No movies found'}

def test_movie_search_without_parameters(client):
    # Test for missing genre and language parameters
    response = client.get('/movies/search')
    assert response.status_code == 400
    assert response.get_json() == {'message': 'Genre and language parameters are required'}

def test_movie_search_with_empty_parameters(client):
    # Test with empty genre and language parameters
    response = client.get('/movies/search?genre=&language=')
    assert response.status_code == 400
    assert response.get_json() == {'message': 'Genre and language parameters are required'}

